(// Helper class within the same package to hold different access levels) s
5 367 M
(class DataHolder {) s
5 358 M
(    // 1. Public: Accessible from anywhere) s
5 349 M
(    public String publicVar = "Public Variable: Accessible everywhere.";) s
5 331 M
(    // 2. Protected: Accessible within the same package and by subclasses) s
5 322 M
(    protected String protectedVar = "Protected Variable: Accessible in same package.";) s
5 304 M
(    // 3. Default \(No keyword\): Accessible only within the same package) s
5 295 M
(    String defaultVar = "Default Variable: Accessible within the package.";) s
5 277 M
(    // 4. Private: Accessible ONLY inside this class) s
5 268 M
(    private String privateVar = "Private Variable: Restrictive, inside DataHolder only.";) s
5 250 M
(    // Public method to show all variables inside their own class) s
5 241 M
(    public void displayAll\(\) {) s
5 232 M
(        System.out.println\("--- Inside DataHolder Class ---"\);) s
5 223 M
(        System.out.println\(publicVar\);) s
5 214 M
(        System.out.println\(protectedVar\);) s
5 205 M
(        System.out.println\(defaultVar\);) s
5 196 M
(        System.out.println\(privateVar\); // Fully accessible here) s
5 187 M
(    }) s
5 169 M
(    // Getter method to allow controlled access to the private variable outside) s
5 160 M
(    public String getPrivateVar\(\) {) s
5 151 M
(        return privateVar;) s
5 142 M
(    }) s
5 133 M
(}) s
